*.doc
*.docx
*.ppt
*.pptx
*.zip
*.7z
*.rar
*.wav
*.mp3
*.mp4
*.m4a

# Runtime and cache
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.log
*.tmp
*.bak
*.backup*

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
